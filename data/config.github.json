{
  "version": "1.0",
  "ai": {
    "provider": "deepseek",
    "provider_chain": null,
    "model": "deepseek-v4-flash",
    "base_url": "https://api.deepseek.com",
    "api_key_env": "DEEPSEEK_API_KEY",
    "temperature": 0.3,
    "max_tokens": 8192,
    "throttle_sec": 1.0,
    "analysis_concurrency": 2,
    "enrichment_concurrency": 1,
    "languages": [
      "zh"
    ],
    "azure_endpoint_env": null,
    "api_version": null
  },
  "sources": {
    "github": [
      {
        "type": "user_events",
        "username": "karpathy",
        "owner": null,
        "repo": null,
        "enabled": true
      },
      {
        "type": "repo_releases",
        "username": null,
        "owner": "vllm-project",
        "repo": "vllm",
        "enabled": true
      },
      {
        "type": "repo_releases",
        "username": null,
        "owner": "sgl-project",
        "repo": "sglang",
        "enabled": true
      }
    ],
    "hackernews": {
      "enabled": true,
      "fetch_top_stories": 30,
      "min_score": 150
    },
    "rss": [
      {
        "name": "Anthropic Research",
        "url": "https://www.anthropic.com/research/rss",
        "enabled": true,
        "category": "ai-research"
      },
      {
        "name": "Simon Willison",
        "url": "https://simonwillison.net/atom/everything/",
        "enabled": true,
        "category": "ai-tools"
      },
      {
        "name": "Lilian Weng",
        "url": "https://lilianweng.github.io/index.xml",
        "enabled": true,
        "category": "ai-research"
      },
      {
        "name": "Ahead of AI (Sebastian Raschka)",
        "url": "https://magazine.sebastianraschka.com/feed",
        "enabled": true,
        "category": "ai-research"
      },
      {
        "name": "Latent Space",
        "url": "https://www.latent.space/feed",
        "enabled": true,
        "category": "ai-industry"
      },
      {
        "name": "Hugging Face Blog",
        "url": "https://huggingface.co/blog/feed.xml",
        "enabled": true,
        "category": "open-source-ai"
      },
      {
        "name": "OpenAI Blog",
        "url": "https://openai.com/blog/rss.xml",
        "enabled": true,
        "category": "ai-industry"
      },
      {
        "name": "Last Week in AI",
        "url": "https://lastweekin.ai/feed",
        "enabled": true,
        "category": "ai-digest"
      },
      {
        "name": "Chip Huyen",
        "url": "https://huyenchip.com/feed.xml",
        "enabled": true,
        "category": "ai-engineering"
      },
      {
        "name": "NVIDIA Developer Blog",
        "url": "https://developer.nvidia.com/blog/feed",
        "enabled": true,
        "category": "hardware"
      }
    ],
    "reddit": {
      "enabled": true,
      "subreddits": [
        {
          "subreddit": "LocalLLaMA",
          "enabled": true,
          "sort": "hot",
          "time_filter": "day",
          "fetch_limit": 10,
          "min_score": 80
        },
        {
          "subreddit": "MachineLearning",
          "enabled": true,
          "sort": "hot",
          "time_filter": "day",
          "fetch_limit": 10,
          "min_score": 80
        }
      ],
      "users": [],
      "fetch_comments": 10
    },
    "telegram": {
      "enabled": false,
      "channels": []
    },
    "twitter": null,
    "openbb": null,
    "ossinsight": {
      "enabled": false,
      "period": "past_24_hours",
      "languages": [
        "All",
        "Python",
        "TypeScript"
      ],
      "keywords": [],
      "min_stars": 5,
      "max_items": 30
    },
    "gdelt": null,
    "google_news": null
  },
  "filtering": {
    "ai_score_threshold": 7.0,
    "time_window_hours": 24,
    "max_items": 15,
    "category_groups": {},
    "default_group": "other",
    "default_group_limit": null
  },
  "email": null,
  "webhook": {
    "enabled": true,
    "url_env": "HORIZON_WEBHOOK_URL",
    "platform": "feishu",
    "layout": "collapsible",
    "fallback_layout": "markdown",
    "languages": ["zh"]
  }
}
